# Chimney Client Configuration
# Copy this file to client.yaml and run:
#   chimney-client -config config/client.yaml
#
# CLI flags override values loaded from this file.

# Relay server address (host:port)
relay_addr: "relay.example.com:443"

# SNI to use (must be in relay's whitelist)
sni: "real-site.example.com"

# Final destination address (host:port)
dest_addr: "final-destination.com:443"

# ── Authentication ──────────────────────────────────────
# Recommended: user_id (UUID). PSK is derived automatically.
#   The relay must have this UUID in its user_ids list.
user_id: "your-uuid-here"

# Alternative: explicit PSK (hex-encoded, 64 chars = 256 bits).
# psk: "YOUR_HEX_PSK_HERE"
# ────────────────────────────────────────────────────────

# Authentication tag length (must match relay config)
tag_len: 16

# Local SOCKS5 proxy listen address
listen_addr: "127.0.0.1:1080"

# uTLS fingerprint to use (chrome, firefox, safari, edge).
# 支持逗号列表轮换(chrome,firefox,edge)与关键字 "rotate"/"auto"。
utls_fingerprint: "chrome"

# 精确指纹校准(可选,优先于 utls_fingerprint):
# 由 cmd/calibrate 从真实浏览器访问目标站点的 pcap 提取的 ClientHello
# (生成 <site>.clienthello)。设置后握手会逐字复刻这条真实 ClientHello,
# 使扩展数量/顺序、ALPN、JA3 与真实浏览器完全一致。
# client_hello_file: "profiles/cloudflare.com.clienthello"

# Built-in traffic shaping for library/CLI clients.
# This pads small tunnel writes toward browser-like TLS record sizes and
# rotates idle tunnels before they become long-lived tunnel fingerprints.
stealth_mode: true
stealth_record_size: 896
max_tunnel_lifetime: 35s

# Connection timeout
connect_timeout: 10s

# TLS handshake timeout
handshake_timeout: 10s
