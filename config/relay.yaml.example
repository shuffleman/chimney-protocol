# Chimney Relay Server Configuration
# Copy this file to relay.yaml and fill in your values.

# Listen address for incoming connections
listen_addr: ":443"

# ── Authentication Mode (pick one) ──────────────────────
#
# Mode A (recommended): UUID list — PSK is derived automatically.
#   PSK = SHA256(UUID), no separate key needed.
#   Client only needs to know its UUID.
user_ids:
  - "your-uuid-here"

# Mode B: explicit userID → PSK mapping for custom key material.
# users:
#   "user1": "hex-psk-for-user1"
#   "user2": "hex-psk-for-user2"

# Mode C: single PSK (backward-compatible, single-user).
# psk: "YOUR_HEX_PSK_HERE"
# ────────────────────────────────────────────────────────

# Authentication tag length (8-32 bytes, 16 recommended)
tag_len: 16

# Intent whitelist file (allowed SNI values)
intent_file: "config/intent.yaml"

# Enforce CIDR whitelist file (allowed destination IPs)
enforce_file: "config/enforce.yaml"

# Cloud region for CIDR validation
# Must match the region where the relay is hosted
cloud_region: "us-east-1"

# Fallback backend for non-authenticated traffic
# If empty, connections are closed naturally on failure (recommended)
default_backend: ""

# Authenticated CONNECT egress policy.
# Empty connect_allow_cidrs means "allow any public target unless denied".
# For production relays, keep connect_deny_private enabled and optionally
# narrow connect_allow_cidrs to your expected upstream networks.
connect_deny_private: true
connect_allow_cidrs: []
connect_deny_cidrs: []

# TLS handshake relay timeout
handshake_timeout: 10s

# Auth record read timeout
auth_read_timeout: 5s

# Enable traffic profiling and pacing
enable_profiling: true

# Directory containing site profile files.
# Note: current relay code does not load per-site profiles from this directory yet.
profile_dir: "profiles"

# ── Downlink traffic shaping (stealth) ──
# 对 relay→client 方向做记录 padding + 下行注水,使代理流量在记录大小、
# 上下行字节比和满 MTU 占比上贴近真实 HTTPS 下载行为。
# 默认关闭;关闭时下行按原始大小裸写(会暴露小记录与上下行对称)。
stealth_mode: true

# 下行注水等级:off / low / medium / high / max。
# 等级越高,目标 down:up 比越大、注入越密,伪装越强但下行带宽开销越大:
#   off=仅记录 padding 不注水, low≈2.5, medium≈5, high≈8, max≈12。
# 空值在 stealth_mode 下取 medium。
downlink_level: "medium"

# 下行记录 padding 的固定目标明文大小(字节)。
# 0 表示按流量 profile 采样,产生更真实的尺寸分布(推荐)。
downlink_record_size: 0

# 显式覆盖等级的下行/上行字节比(down:up)。0 取等级预设;负值关闭注水。
downlink_ratio_target: 0

# CIDR refresh interval from cloud providers
cidr_refresh_interval: 24h

# Log level: debug, info, warn, error
log_level: "info"

# Metrics endpoint address (optional, empty to disable)
# Admin endpoints require metrics_token, or are restricted to loopback clients
# when metrics_token is empty. Prefer binding to localhost unless a trusted
# reverse proxy adds authentication.
metrics_addr: "127.0.0.1:8080"
metrics_token: ""
